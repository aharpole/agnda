# Copy this file to .env and fill in your values.
#
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or use an existing one)
# 3. Enable the Google Calendar API
# 4. Go to APIs & Services > Credentials > Create Credentials > OAuth 2.0 Client ID
# 5. Application type: Web application
# 6. Add authorized redirect URI: http://localhost:4567/oauth/callback
# 7. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Port the companion app listens on (must match your Google OAuth redirect URI)
PORT=4567

# Your local timezone (used to compute "today's" events and times)
# Find yours: ruby -e "require 'time'; puts Time.now.zone"
# Examples: America/New_York, America/Chicago, America/Los_Angeles, America/Denver
TIMEZONE=America/New_York

# How many minutes of event cache before re-fetching from Google (default: 5)
CACHE_TTL_MINUTES=5
