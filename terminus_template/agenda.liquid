{% comment %}
  TRMNL Daily Agenda — Option A (Minimal grotesque)
  800×480 e-ink. Exchange data accessed via source_1.* prefix.
{% endcomment %}

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  svg { fill: none; }

  .screen {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    overflow: hidden;
    background: #fff;
    color: #000;
    font-family: 'IBM Plex Sans', sans-serif;
    display: flex;
    flex-direction: column;
    writing-mode: horizontal-tb;
    transform: none;
  }

  /* ── Header ── */
  .hdr {
    flex-shrink: 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 18px 28px 16px;
    border-bottom: 3px solid #000;
  }
  .hdr-left  { display: flex; align-items: baseline; gap: 14px; }
  .hdr-dow   { font: 700 30px/1 'IBM Plex Sans', sans-serif; letter-spacing: -.01em; }
  .hdr-date  { font: 500 30px/1 'IBM Plex Sans', sans-serif; color: #8a8780; }
  .hdr-right { display: flex; align-items: center; gap: 22px; }
  .wx        { display: flex; align-items: center; gap: 8px; }
  .wx-t      { font: 600 19px/1 'IBM Plex Mono', monospace; }
  .bat       { display: flex; align-items: center; gap: 7px; }
  .bat-p     { font: 600 14px/1 'IBM Plex Mono', monospace; }

  /* ── Body row ── */
  .body-row { flex: 1; display: flex; min-height: 0; }

  /* ── Hero (Up Next) ── */
  .hero {
    width: 322px;
    flex-shrink: 0;
    border-right: 3px solid #000;
    padding: 22px 26px;
    display: flex;
    flex-direction: column;
  }
  .hero-top      { display: flex; align-items: center; justify-content: space-between; }
  .hero-lbl      { font: 700 12px/1 'IBM Plex Mono', monospace; letter-spacing: .16em; text-transform: uppercase; }
  .hero-pill     { font: 600 12px/1 'IBM Plex Mono', monospace; color: #fff; background: #000; padding: 5px 9px; }
  .hero-time-row { display: flex; align-items: baseline; gap: 8px; margin-top: 18px; }
  .hero-h        { font: 700 62px/.85 'IBM Plex Mono', monospace; letter-spacing: -.02em; }
  .hero-ampm     { font: 600 20px/1 'IBM Plex Mono', monospace; }
  .hero-range    { font: 500 14px/1 'IBM Plex Mono', monospace; color: #8a8780; margin-top: 8px; }
  .hero-title    { font: 700 25px/1.15 'IBM Plex Sans', sans-serif; letter-spacing: -.01em; margin-top: 18px; }
  .hero-loc      { display: flex; align-items: center; gap: 8px; margin-top: auto; }
  .hero-loc span { font: 500 15px/1.2 'IBM Plex Sans', sans-serif; }

  /* ── Later today ── */
  .later {
    flex: 1;
    padding: 16px 26px 18px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .later-lbl { font: 700 12px/1 'IBM Plex Mono', monospace; letter-spacing: .16em; text-transform: uppercase; color: #8a8780; margin-bottom: 6px; }
  .ev-row    { display: flex; align-items: flex-start; gap: 16px; padding: 13px 0; border-bottom: 1px solid #d8d6cf; }
  .ev-row:last-of-type { border-bottom: none; }
  .ev-t      { flex-shrink: 0; width: 74px; padding-top: 1px; }
  .ev-t-n    { font: 600 17px/1 'IBM Plex Mono', monospace; }
  .ev-t-m    { font: 500 11px/1 'IBM Plex Mono', monospace; color: #8a8780; margin-top: 4px; }
  .ev-i      { flex: 1; min-width: 0; }
  .ev-ttl    { font: 600 18px/1.15 'IBM Plex Sans', sans-serif; }
  .ev-loc    { font: 400 13px/1.2 'IBM Plex Sans', sans-serif; color: #8a8780; margin-top: 3px; }
  .ev-dur    { flex-shrink: 0; font: 500 13px/1 'IBM Plex Mono', monospace; color: #8a8780; padding-top: 3px; }
  .footer    { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: 10px; }
  .footer span { font: 500 11px/1 'IBM Plex Mono', monospace; color: #b3b0a8; }

  /* ── All-done state ── */
  .done-body  { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 0 40px; }
  .done-title { font: 700 34px/1.1 'IBM Plex Sans', sans-serif; letter-spacing: -.01em; margin-top: 22px; }
  .done-sub   { font: 400 17px/1.4 'IBM Plex Sans', sans-serif; color: #8a8780; margin-top: 10px; }
  .done-foot  { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; padding: 14px 28px; border-top: 1px solid #d8d6cf; }
  .done-foot span { font: 500 11px/1 'IBM Plex Mono', monospace; color: #b3b0a8; }
</style>

{% assign d = source_1 %}

<div class="screen">

  <!-- ── Header ── -->
  <div class="hdr">
    <div class="hdr-left">
      <div class="hdr-dow">{{ d.day_of_week }}</div>
      <div class="hdr-date">{{ d.month_day }}</div>
    </div>
    <div class="hdr-right">
      {% if d.weather_temp %}
      <div class="wx">
        <svg width="22" height="22" viewBox="0 0 24 24" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <span class="wx-t">{{ d.weather_temp }}°</span>
      </div>
      {% endif %}
      {% if d.battery_pct %}
      <div class="bat">
        <svg width="26" height="14" viewBox="0 0 26 14" stroke="#000" stroke-width="1.6">
          <rect x="1" y="1" width="20" height="12" rx="2"/>
          {% assign fill_w = d.battery_pct | times: 0.135 | round %}
          <rect x="3" y="3" width="{{ fill_w }}" height="8" rx="1" style="fill:#000;stroke:none"/>
          <rect x="23" y="4.5" width="2.5" height="5" rx="1" style="fill:#000;stroke:none"/>
        </svg>
        <span class="bat-p">{{ d.battery_pct }}%</span>
      </div>
      {% endif %}
    </div>
  </div>

  {% if d.auth_error %}

  <!-- ── Auth-error state ── -->
  <div class="done-body">
    <svg width="64" height="56" viewBox="0 0 64 64">
      <path d="M32 6 L60 56 L4 56 Z" fill="none" stroke="#000" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <line x1="32" y1="26" x2="32" y2="40" stroke="#000" stroke-width="5" stroke-linecap="round"/>
      <circle cx="32" cy="48" r="3" fill="#000" stroke="none"/>
    </svg>
    <div class="done-title">Calendar disconnected</div>
    <div class="done-sub">Google needs re-authorization for
      {{ d.auth_error_accounts | join: " and " }}.<br>
      Open the agenda setup page to reconnect.</div>
  </div>
  <div class="done-foot">
    <span>Synced {{ d.synced_at }}</span>
    <span>localhost:4567/setup</span>
  </div>

  {% elsif d.is_all_done %}

  <!-- ── All-done state ── -->
  <div class="done-body">
    <svg width="64" height="56" viewBox="0 0 64 56">
      <path d="M 4,26 C 6,30 14,44 20,50 C 30,42 46,20 60,6" fill="none" stroke="#000" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <div class="done-title">You're all done</div>
    {% if d.tomorrow_first %}
    <div class="done-sub">Nothing left on the calendar today.<br>Next event is tomorrow, {{ d.tomorrow_first }}.</div>
    {% else %}
    <div class="done-sub">Nothing left on the calendar today.</div>
    {% endif %}
  </div>
  <div class="done-foot">
    <span>Synced {{ d.synced_at }}</span>
    <span>{{ d.completed_today }} event{% if d.completed_today != 1 %}s{% endif %} completed</span>
  </div>

  {% else %}

  <!-- ── Default state ── -->
  <div class="body-row">

    <!-- Up Next hero -->
    <div class="hero">
      <div class="hero-top">
        <span class="hero-lbl">Up Next</span>
        <span class="hero-pill">{{ d.next_event.countdown }}</span>
      </div>
      <div class="hero-time-row">
        <span class="hero-h">{{ d.next_event.start_time }}</span>
        <span class="hero-ampm">{{ d.next_event.start_meridiem }}</span>
      </div>
      <div class="hero-range">{{ d.next_event.time_range }} · {{ d.next_event.duration }}</div>
      <div class="hero-title">{{ d.next_event.title }}</div>
      <div class="hero-loc">
        <svg width="16" height="16" viewBox="0 0 24 24">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" fill="none" stroke="#000" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="12" cy="10" r="2.6" fill="none" stroke="#000" stroke-width="1.9"/>
        </svg>
        <span>{{ d.next_event.location }}</span>
      </div>
    </div>

    <!-- Later today -->
    <div class="later">
      <div class="later-lbl">Later Today · {{ d.later_events.size }}</div>

      {% for event in d.later_events %}
      <div class="ev-row">
        <div class="ev-t">
          <div class="ev-t-n">{{ event.start_time }}</div>
          <div class="ev-t-m">{{ event.start_meridiem }}</div>
        </div>
        <div class="ev-i">
          <div class="ev-ttl">{{ event.title }}</div>
          <div class="ev-loc">{{ event.location }}</div>
        </div>
        <div class="ev-dur">{{ event.duration }}</div>
      </div>
      {% endfor %}

      {% if d.later_events.size == 0 %}
      <div class="ev-row" style="color:#8a8780;font-size:14px;border-bottom:none;">
        Nothing else scheduled today.
      </div>
      {% endif %}

      <div class="footer">
        <span>Synced {{ d.synced_at }}</span>
        <span>{{ d.total_today }} event{% if d.total_today != 1 %}s{% endif %} today</span>
      </div>
    </div>

  </div>
  {% endif %}

</div>
